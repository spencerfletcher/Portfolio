---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Links" noindex>
	<div class="page-center">
		<div class="wrapper">
			<h1>Links</h1>
			<div class="links">
				<a
					href="https://common-arrow-6e2.notion.site/Recipes-31b99dd0d60a802ab0bdd8b6b46910bd"
				>
					Recipes
				</a>
				<a
					href="https://common-arrow-6e2.notion.site/Transition-31b99dd0d60a804ba37dedc35e5aedde"
				>
					Transition Checklist
				</a>
				<a
					href="https://common-arrow-6e2.notion.site/Close-31b99dd0d60a805dacb3ec00e92e6988"
				>
					Closing Checklist
				</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.page-center {
		min-height: 100dvh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-8);
	}

	.wrapper {
		width: 100%;
		max-width: 380px;
	}

	/* Semantically the page heading, but visually it plays the section-label
	   role — a display-size h1 would overwhelm a 380px column. */
	h1 {
		font-size: var(--text-lg);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-secondary);
		margin-bottom: var(--space-6);
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.links a {
		display: block;
		padding: 0.9rem 1.25rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		color: var(--text-primary);
		text-decoration: none;
		font-size: var(--text-base);
		font-weight: 500;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.links a:hover {
		border-color: var(--accent);
		background: var(--bg-card-hover);
	}
</style>
