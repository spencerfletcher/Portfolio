---
import Layout from "../layouts/Layout.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectDetailPanel from "../components/ProjectDetailPanel.astro";
import MemoryGuardDemo from "../components/MemoryGuardDemo.astro";
import ForkDemo from "../components/ForkDemo.astro";
---

<Layout
  title="Spencer Fletcher — Software Engineer"
  description="Spencer Fletcher, UBC computer science graduate. Software engineer working on market-making engines, Clang/LLVM memory-safety tooling, and full-stack web platforms."
>
  <div class="page">
    <main>
      <header>
        <div class="header-content">
          <p class="eyebrow">Open to work · UBC CS · US citizen</p>
          <h1>Spencer Fletcher</h1>
          <p class="subtitle">
            I’m a UBC CS grad who builds high-quality tools for problems I care
            about, from a <a href="#poly">live market-making engine</a>, to a
            <a href="#mem"> Clang/LLVM memory-analysis tool</a>, to
            <a href="#fork"> Fork</a>, a recipe workspace I built for developing
            my own recipes. I like taking software from an idea through testing,
            deployment, and real use.
          </p>
        </div>

        <div class="header-cta">
          <a href="mailto:spencer@spencerfletcher.com" class="cta-button">
            Email Me
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="/Spencer_Fletcher.pdf"
            class="cta-button cta-button-secondary">Resume →</a
          >
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://linkedin.com/in/spencer-fletcher-dev"
            class="cta-button cta-button-secondary">LinkedIn →</a
          >
        </div>
      </header>

      <section class="projects">
        <h2>Projects</h2>

        <div class="projects-container">
          <ProjectCard
            featured
            title="Automated Market-Making Engine"
            year="2026 - Ongoing"
            description="A Python market-making engine running live capital on Polymarket US, with <strong>154k+ contracts</strong> and <strong>$77k+ in gross notional</strong> filled over seven weeks. Built on AWS with persistent WebSocket market data, exact-decimal accounting, crash recovery and reconciliation, and <strong>an automated test suite of more than 12,000 tests</strong>. The system evolved from an earlier cross-venue arbitrage experiment after I measured the practical limits of competing on taker latency."
            tags={["Python", "Websockets", "asyncio", "AWS"]}
            links={[
              {
                label: "Market Maker →",
                href: "https://github.com/spencerfletcher/market-maker",
              },
              {
                label: "Arbitrage Engine →",
                href: "https://github.com/spencerfletcher/arbitrage-engine",
              },
            ]}
            href="https://github.com/spencerfletcher/market-maker"
            note="Market selection and tuned parameters are withheld."
            id="poly"
            panel
            detailLayout="stack"
          >
            <Fragment slot="details">
              <HowItWorks
                items={[
                  {
                    type: "object",
                    label: "Live Market Universe",
                  },
                  {
                    type: "stage",
                    label:
                      "Stage 1 — Discover & Observe · asyncio / REST / WebSockets",
                    desc: "Discovers eligible markets over REST, filters out poor quoting candidates, then maintains fresh order books through concurrent WebSocket feeds and on-demand reads.",
                  },
                  {
                    type: "object",
                    label: "Fresh Order Books",
                  },
                  {
                    type: "stage",
                    label: "Stage 2 — Quote & Book · Python / Decimal",
                    desc: "Computes maker prices and sizes, maintains resting orders, and consumes private fill events. Executions are booked idempotently with exact-decimal accounting.",
                  },
                  {
                    type: "object",
                    label: "Orders + Fill Ledger",
                  },
                  {
                    type: "stage",
                    label:
                      "Stage 3 — Persist & Reconcile · AWS / Crash Recovery",
                    desc: "Persists the state needed for recovery and reconciles local records against the exchange after restarts or ambiguous failures. Unverified state remains unsafe instead of being treated as flat.",
                  },
                  {
                    type: "object",
                    label: "Reconciled Trading State",
                  },
                ]}
              />
              <span class="notes">
                <strong>Development process:</strong> I built this partly as an experiment
                in AI-assisted development. Claude Code accelerated implementation
                and testing, while exchange behavior, accounting assumptions, and
                failure paths were validated against real or recorded venue behavior.
              </span>
            </Fragment>
          </ProjectCard>

          <ProjectCard
            title="Fork: A Recipe Versioning Platform"
            year="2025 - Ongoing"
            description="I built Fork because I wanted a better way to develop my own recipes without losing track of what changed or which version worked. It’s a full-stack SvelteKit/PostgreSQL recipe workspace with <strong>ingredient and instruction history, structured diffs, public/private recipes, and attributed variations</strong>. I used the project to learn SvelteKit while building around a problem I genuinely care about as a cook."
            tags={["SvelteKit", "SQL", "TypeScript"]}
            links={[
              {
                label: "View Code →",
                href: "https://github.com/spencerfletcher/Fork",
              },
              {
                label: "Live Project →",
                href: "https://recipes.spencerfletcher.com",
              },
            ]}
            href="https://github.com/spencerfletcher/Fork"
            id="fork"
            panel
            detailLayout="stack"
          >
            <Fragment slot="details">
              <ForkDemo />
              <HowItWorks
                items={[
                  {
                    type: "object",
                    label: "Your Recipe",
                  },
                  {
                    type: "stage",
                    label: "Stage 1 — Write & Version · SvelteKit / PostgreSQL",
                    desc: "Stores recipe metadata separately from versioned ingredients and instructions, preserving each saved formulation as a revision with its own commit message.",
                  },
                  {
                    type: "object",
                    label: "Recipe History",
                  },
                  {
                    type: "stage",
                    label: "Stage 2 — Compare · TypeScript / Structured Diff",
                    desc: "Compares revisions ingredient-by-ingredient and step-by-step, generating word-level diffs so changes to amounts, ingredients, and instructions stay readable.",
                  },
                  {
                    type: "object",
                    label: "Version Diff",
                  },
                  {
                    type: "stage",
                    label: "Stage 3 — Adapt & Attribute · SvelteKit / Supabase",
                    desc: "Creates an independent variation from the latest revision in a single transaction, preserving its source relationship and attribution while leaving the original untouched.",
                  },
                  {
                    type: "object",
                    label: "Attributed Variation",
                  },
                ]}
              />
              <span class="notes">
                <strong>Production hardening:</strong> Added Drizzle migrations, Supabase
                row-level security, and CI checks after finding inconsistencies between
                local and production database schemas.
              </span>
            </Fragment>
          </ProjectCard>

          <ProjectCard
            title="MemoryGuard"
            year="2024"
            description="A Clang/LLVM dynamic-analysis tool for C, co-developed in a four-person course team. It <strong>combines AST instrumentation with runtime heap tracking</strong> to detect memory leaks and use-after-free and reports findings against the original source. My work included <strong>runtime use-after-free detection</strong> for aliased heap pointers and peer review across the project."
            tags={["C++", "CMake", "Python"]}
            links={[
              {
                label: "View Code →",
                href: "https://github.com/spencerfletcher/MemoryGuard",
              },
            ]}
            href="https://github.com/spencerfletcher/MemoryGuard"
            id="mem"
            panel
            detailLayout="split"
          >
            <Fragment slot="details">
              <HowItWorks
                items={[
                  { type: "object", label: "Your C File" },
                  {
                    type: "stage",
                    label: "Stage 1 — AST Instrumentation · Clang / LLVM",
                    desc: "Traverses the AST and injects analysis hooks around malloc, free, dereferences, and aliasing.",
                  },
                  {
                    type: "object",
                    label: "instrumented.c",
                  },
                  {
                    type: "stage",
                    label: "Stage 2 — Runtime Analysis · C++ shared library",
                    desc: "Tracks pointer state at runtime, builds a shadow map of allocations, and records errors to JSON.",
                  },
                  {
                    type: "object",
                    label: "output_report.json",
                  },
                  {
                    type: "stage",
                    label: "Stage 3 — Visual Report · Python / Pygments",
                    desc: "Annotates the original source with error messages and renders a syntax-highlighted PNG.",
                  },
                  {
                    type: "object",
                    label: "test.png",
                  },
                  {
                    type: "object",
                    label: "Annotated source — exact error locations",
                  },
                ]}
              />
              <MemoryGuardDemo />
            </Fragment>
          </ProjectCard>

          <ProjectCard
            title="UBC Medicine — Website Redesign"
            year="2022 - 2023"
            description="Implemented another team’s redesign of UBC Medicine’s Body Donation Program website in WordPress/JavaScript; <strong>body donations more than doubled after launch</strong>. Also overhauled a staff directory serving hundreds of users, replacing linear search with binary search over an alphabetized index."
            tags={["HTML", "CSS", "JavaScript", "WordPress"]}
            links={[
              {
                label: "View Code →",
                href: "https://github.com/spencerfletcher/body-donation-site",
              },
              {
                label: "Live Project →",
                href: "https://cps.med.ubc.ca/body-donation/",
              },
            ]}
            href="https://cps.med.ubc.ca/body-donation/"
            id="ubc"
          />

          <ProjectCard
            title="Hollywood Theatre Automation"
            year="2024 - 2025 · Freelance"
            description="Built a Google Apps Script tip-splitting workflow <strong>(~5 hours/week saved)</strong> and a JavaScript marquee letter tracker <strong>(~2 hours/week saved)</strong> for the Hollywood Theatre in Vancouver."
            tags={["JavaScript", "Google Apps Script"]}
            note="Source unavailable — client project."
            id="tips"
          />
        </div>
        <ProjectDetailPanel />
      </section>

      <section class="tools">
        <h2>Technical Skills</h2>
        <div class="skills-inline">
          <div class="skill-group">
            <h3>Programming</h3>
            <p>Python · C++ · C · TypeScript · JavaScript · Java · Assembly</p>
          </div>
          <div class="skill-group">
            <h3>Web & Data</h3>
            <p>
              SvelteKit · React · Node.js · PostgreSQL · Supabase · REST APIs
            </p>
          </div>
          <div class="skill-group">
            <h3>Systems & Tools</h3>
            <p>Claude Code · Linux · AWS · Git · Docker · CI/CD · WebSockets</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="social-links">
      <a
        href="https://github.com/spencerfletcher"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
      >
        <img src="/github.svg" height="24" width="24" alt="" />
      </a>
      <a
        href="https://www.linkedin.com/in/spencer-fletcher-dev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
      >
        <img src="/linkedin.png" height="24" width="24" alt="" />
      </a>
      <a href="mailto:spencer@spencerfletcher.com" class="footer-email">
        spencer@spencerfletcher.com
      </a>
    </footer>
  </div>
</Layout>

<style is:global>
  .page {
    /* content-box so the 860px is the measure itself — the responsive
		   padding below sits outside it rather than eating into it. */
    box-sizing: content-box;
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  .subtitle > a {
    font-weight: 600;
    color: var(--text-primary);
  }

  .subtitle > a:hover {
    color: var(--accent);
  }

  main {
    margin-top: var(--space-12);
  }

  section {
    margin-bottom: var(--space-12);
  }

  /* Header */
  header {
    padding-bottom: var(--space-12);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    font-weight: 400;
  }

  .header-cta {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
    border: 1.5px solid var(--accent);
    background: var(--accent);
    color: var(--bg-primary);
    letter-spacing: 0.01em;
  }

  .cta-button:hover {
    background: transparent;
    color: var(--accent);
  }

  .cta-button-secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border);
  }

  .cta-button-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  /* Projects */
  .projects-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  /* Skills — compact inline layout */
  .skills-inline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
  }

  .skill-group h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .skill-group p {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.8;
  }

  /* Footer */
  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) 0 var(--space-12);
    border-top: 1px solid var(--border);
  }

  .social-links a {
    opacity: var(--opacity-faint);
    transition: opacity 0.2s ease;
  }

  .social-links a:hover {
    opacity: 1;
  }

  .social-links img {
    width: 28px;
    height: 28px;
    filter: brightness(0) invert(1);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .page {
      padding: var(--space-4);
    }

    .projects-container {
      grid-template-columns: 1fr;
    }

    .header-cta {
      flex-wrap: wrap;
    }
  }

  @media (min-width: 768px) {
    .page {
      padding: var(--space-12);
    }

    .skills-inline {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  /* Subtle entrance animation */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  header {
    animation: fadeUp 0.5s ease both;
  }

  .projects {
    animation: fadeUp 0.5s ease 0.1s both;
  }

  .tools {
    animation: fadeUp 0.5s ease 0.2s both;
  }

  .social-links {
    animation: fadeUp 0.5s ease 0.3s both;
  }

  /* Flashes a card when the hero text links to it. */
  .glow {
    animation: card-glow 1.5s ease-out;
  }

  @keyframes card-glow {
    0% {
      box-shadow: 0 0 0 0 var(--accent-glow);
    }
    15% {
      box-shadow: 0 0 24px 4px rgba(124, 111, 240, 0.55);
    }
    70% {
      box-shadow: 0 0 24px 4px rgba(124, 111, 240, 0.55);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(124, 111, 240, 0);
    }
  }

  .notes {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .notes strong {
    color: var(--text-secondary);
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll(".subtitle > a").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");
      if (!href) return;
      const card = document.getElementById(href.slice(1));
      if (!card) return;
      e.preventDefault(); // take over so we can smooth-scroll + glow
      card.scrollIntoView({ behavior: "smooth", block: "center" });
      card.classList.remove("glow");
      void (card as HTMLElement).offsetWidth;
      card.classList.add("glow");
    });
  });
</script>
