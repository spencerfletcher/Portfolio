---
interface Props {
	title: string;
	year: string;
	description: string;
	tags: string[];
	links?: { label: string; href: string }[];
	href?: string;
	featured?: boolean;
	note?: string;
	id?: string;
	/* Render the details panel expanded on load. The toggle still works. */
	detailsOpen?: boolean;
}

const {
	title,
	year,
	description,
	tags,
	links,
	href,
	featured,
	note,
	id,
	detailsOpen = false,
} = Astro.props;
const hasDetails = Astro.slots.has("details");
---

<article class:list={[{ featured }]} id={id}>
	{featured && <div class="featured-label">Featured</div>}
	{/* The title anchor stretches over the whole card via ::after, so the card
	    is clickable without giving up real link behaviour (cmd-click, middle
	    click, copy link, screen-reader announcement). */}
	<h3>
		{
			href ? (
				<a class="card-link" href={href} target="_blank" rel="noopener noreferrer">
					{title}
				</a>
			) : (
				title
			)
		}
	</h3>
	<span class="year">{year}</span>
	<p set:html={description} />
	<div class="tags">
		<div class="tag-list">
			{tags.map((tag) => <span class="tag">{tag}</span>)}
		</div>
		{
			hasDetails && (
				<button
					class:list={["how-it-works-btn", { open: detailsOpen }]}
					aria-expanded={String(detailsOpen)}
					aria-controls={`details-${id}`}
				>
					<span class="btn-label">
						{detailsOpen ? "Hide details" : "How it works"}
					</span>
					<span class="chevron" aria-hidden="true">▾</span>
				</button>
			)
		}
	</div>
	{
		hasDetails && (
			<div
				class:list={["details-wrapper", { open: detailsOpen }]}
				id={`details-${id}`}
			>
				<div class="details-inner">
					<div class="details-content">
						<slot name="details" />
					</div>
				</div>
			</div>
		)
	}
	{
		links && links.length > 0 && (
			<div class="links">
				{links.map((link) => (
					<a target="_blank" rel="noopener noreferrer" href={link.href}>
						{link.label}
					</a>
				))}
			</div>
		)
	}
	{note && <p class="note">{note}</p>}
</article>

<style is:global>
	.projects-container article {
		/* Hero anchor targets (#poly etc.) shouldn't land flush with the
		   viewport edge when JS is off. */
		scroll-margin-top: var(--space-8);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			transform 0.25s ease,
			box-shadow 0.25s ease;
		position: relative;
	}

	.projects-container article:has(.card-link) {
		cursor: pointer;
	}

	.projects-container article:has(.card-link):hover {
		background: var(--bg-card-hover);
		border-color: var(--border-hover);
		transform: translateY(-2px);
	}

	/* Focus lands on the title anchor but should read as the whole card. */
	.card-link:focus-visible {
		outline: none;
	}

	.projects-container article:has(.card-link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.card-link {
		color: var(--text-primary);
		font-weight: inherit;
	}

	.card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.projects-container article:has(.card-link):hover .card-link {
		color: var(--accent);
	}

	.projects-container article.featured {
		grid-column: 1 / -1;
		background: var(--bg-featured);
		border-color: rgba(139, 124, 247, 0.2);
		padding: var(--space-8);
	}

	.projects-container article.featured:has(.card-link):hover {
		background: var(--bg-featured);
		border-color: var(--accent-border-strong);
		box-shadow: 0 8px 32px var(--accent-glow);
	}

	.projects-container article p {
		color: var(--text-secondary);
		font-size: var(--text-base);
		line-height: 1.65;
	}

	/* of-type, not nth-child: Astro drops this component's <script> into the container as a sibling, which would otherwise flip the parity. */
	.projects-container article:last-of-type:nth-of-type(even) {
		grid-column: 1;
	}

	.featured-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin-bottom: var(--space-3);
	}

	.year {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-tertiary);
		margin-bottom: var(--space-3);
	}

	.tags {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin: var(--space-4) 0;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.tag {
		font-family: var(--font-mono);
		background: var(--accent-subtle);
		color: var(--accent);
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	/* Toggle button */
	.how-it-works-btn {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-primary);
		font-weight: 600;
		background: transparent;
		border: 1px solid var(--accent-border);
		border-radius: var(--radius-sm);
		padding: 0.4rem 0.8rem;
		cursor: pointer;
		letter-spacing: 0.02em;
		opacity: var(--opacity-resting);
		transition:
			opacity 0.15s ease,
			border-color 0.15s ease,
			background-color 0.15s ease;
		white-space: nowrap;
	}

	.how-it-works-btn:hover {
		opacity: 1;
		border-color: var(--accent-border-strong);
		background-color: var(--accent-subtle);
	}

	.how-it-works-btn .chevron {
		display: inline-block;
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		color: var(--accent);
	}

	.how-it-works-btn.open .chevron {
		transform: rotate(-180deg);
	}

	/* CSS grid height animation — no JS measurement, no max-height hack */
	.details-wrapper {
		/* Above the card-link overlay: an expanded panel is a lot of surface to
		   accidentally navigate away from. */
		position: relative;
		z-index: 2;
		cursor: auto;
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.details-wrapper.open {
		grid-template-rows: 1fr;
	}

	.details-inner {
		min-height: 0;
		overflow: hidden;
	}

	/* auto-fit collapses empty tracks: 1 panel fills the row, 2 sit side by
	   side, and they stack on their own once a column can't hold 280px. */
	.details-content {
		padding: var(--space-2) 0 var(--space-3);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
		gap: 0.65rem;
	}

	/* ── Reusable panel layout ───────────────────────────────────── */

	.detail-panel {
		background: var(--bg-panel);
		border: 1px solid var(--border-faint);
		border-radius: var(--radius-md);
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.detail-panel-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.3rem 0.65rem;
		border-bottom: 1px solid var(--border-faint);
		background: rgba(255, 255, 255, 0.025);
	}

	.detail-panel-label {
		font-size: var(--text-2xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
	}

	.detail-panel-caption {
		font-size: var(--text-2xs);
		color: var(--text-tertiary);
	}

	/* ── Pipeline panel ──────────────────────────────────────────── */
	.pipeline-body {
		padding: 0.85rem var(--space-3);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.pipeline-edge {
		font-size: var(--text-2xs);
		color: var(--text-tertiary);
	}

	.pipeline-stage {
		width: 100%;
		border: 1px solid var(--border-faint);
		border-left: 2px solid rgba(139, 124, 246, 0.5);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		padding: var(--space-2) 0.65rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.pipeline-stage-num {
		font-size: var(--text-xs);
		color: var(--accent);
		flex-shrink: 0;
	}

	.pipeline-stage-desc {
		font-size: var(--text-2xs);
		color: var(--text-tertiary);
		line-height: 1.5;
		font-family: var(--font-mono);
	}

	.pipeline-connector {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.08rem;
		padding: 0.18rem 0;
	}

	.pipeline-connector-line {
		width: 1px;
		height: 7px;
		background: rgba(255, 255, 255, 0.1);
	}

	.pipeline-connector-caret {
		font-size: var(--text-2xs);
		color: rgba(255, 255, 255, 0.15);
		line-height: 1;
	}

	.links {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: auto;
		padding-top: var(--space-2);
	}

	.links a {
		font-size: var(--text-sm);
	}

	.note {
		font-style: italic;
		font-size: var(--text-sm);
		color: var(--text-tertiary);
		margin-top: auto;
		padding-top: var(--space-2);
	}

	@media (max-width: 640px) {
		.projects-container article.featured {
			grid-column: 1;
		}
	}
</style>

<script>
	document
		.querySelectorAll<HTMLButtonElement>(".how-it-works-btn")
		.forEach((btn) => {
			btn.addEventListener("click", () => {
				const wrapperId = btn.getAttribute("aria-controls");
				if (!wrapperId) return;
				const wrapper = document.getElementById(wrapperId);
				if (!wrapper) return;
				const isOpen = !wrapper.classList.contains("open");
				wrapper.classList.toggle("open", isOpen);
				btn.classList.toggle("open", isOpen);
				btn.setAttribute("aria-expanded", String(isOpen));
				const label = btn.querySelector(".btn-label");
				if (label) label.textContent = isOpen ? "Hide details" : "How it works";
			});
		});
</script>
