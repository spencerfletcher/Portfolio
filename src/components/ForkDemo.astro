---
/* Fork's panel block: one framed product shot linking to a live diff. */
const diffUrl =
  "https://recipes.spencerfletcher.com/recipes/classic-chocolate-chip-cookies-0bNW21/diff?from=2&to=3";
---

<div class="fork-demo">
  <a class="fork-shot" href={diffUrl} target="_blank" rel="noopener noreferrer">
    <span class="fork-chrome" aria-hidden="true">recipes.spencerfletcher.com</span>
    <img
      src="/fork.png"
      width="2048"
      height="1232"
      alt="Fork diff view: v2 to v3 of a cookie recipe showing ingredient and step changes"
      loading="lazy"
    />
  </a>
  <p class="fork-caption">
    <a href={diffUrl} target="_blank" rel="noopener noreferrer"
      >Open the live diff →</a
    >
  </p>
</div>

<style>
  .fork-shot {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    cursor: pointer;
  }

  .fork-shot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .fork-chrome {
    display: block;
    padding: 0.3rem 0.65rem;
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border-faint);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-tertiary);
    text-align: center;
  }

  /* width/height attributes reserve the box; this just fills it. */
  .fork-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .fork-caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-tertiary);
  }
</style>
