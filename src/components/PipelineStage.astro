---
interface Props {
	label: string;
	desc: string;
}

const { label, desc } = Astro.props;
---

<div class="pipeline-stage">
	<span class="pipeline-stage-num">{label}</span>
	<p class="pipeline-stage-desc">{desc}</p>
</div>

<style>
	.pipeline-stage-num {
		display: block;
		margin-bottom: var(--space-1);
	}
</style>
