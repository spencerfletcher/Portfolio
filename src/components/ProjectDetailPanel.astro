<style is:global>
  /* Optional: keep the expanded pipelines a little tighter. */
  .detail-row .pipeline-body {
    padding: var(--space-2) var(--space-3);
  }

  .detail-row .pipeline-stage {
    padding: 0.3rem 0.5rem;
  }

  .detail-row .pipeline-connector {
    padding: 0.05rem 0;
  }

  .detail-row .pipeline-connector-line {
    height: 4px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-panel-target]",
  );

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let active: HTMLButtonElement | null = null;

  function getDetail(id: string) {
    return document.querySelector<HTMLElement>(
      `[data-detail-for="${CSS.escape(id)}"]`,
    )!;
  }

  function place(card: HTMLElement, detail: HTMLElement) {
    const grid = card.parentElement!;

    const rowCards = Array.from(
      grid.querySelectorAll<HTMLElement>(":scope > article"),
    ).filter((el) => el.offsetTop === card.offsetTop);

    const rowEnd = rowCards.at(-1)!;
    rowEnd.after(detail);

    const notch = card.offsetLeft + card.offsetWidth / 2 - detail.offsetLeft;

    detail.style.setProperty("--notch-x", `${notch}px`);
  }

  function close() {
    if (!active) return;

    const id = active.dataset.panelTarget!;
    getDetail(id).hidden = true;

    active.setAttribute("aria-expanded", "false");
    active.classList.remove("open");
    active.querySelector(".btn-label")!.textContent = "How it works";

    active = null;
  }

  function open(btn: HTMLButtonElement) {
    const id = btn.dataset.panelTarget!;
    const card = document.getElementById(id)!;
    const detail = getDetail(id);

    close();
    place(card, detail);

    active = btn;
    btn.setAttribute("aria-expanded", "true");
    btn.classList.add("open");
    btn.querySelector(".btn-label")!.textContent = "Hide details";

    detail.hidden = false;

    if (detail.getBoundingClientRect().bottom > innerHeight) {
      detail.scrollIntoView({
        block: "nearest",
        behavior: reduced ? "auto" : "smooth",
      });
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => (btn === active ? close() : open(btn)));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !active) return;

    const btn = active;
    close();
    btn.focus();
  });

  addEventListener("resize", () => {
    if (!active) return;

    const id = active.dataset.panelTarget!;
    place(document.getElementById(id)!, getDetail(id));
  });
</script>
